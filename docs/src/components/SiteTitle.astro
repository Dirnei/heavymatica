---
import { optimize } from 'svgo';
import source from '../../../src/branding/heavymatica.svg?raw';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;

// Inlined so the header paints with the page instead of waiting for an image request.
const logo = optimize(source, {
  multipass: true,
  plugins: [
    { name: 'preset-default', params: { overrides: { removeViewBox: false } } },
    'removeDimensions',
    { name: 'prefixIds', params: { prefix: 'logo' } },
    { name: 'addAttributesToSVGElement', params: { attributes: [{ 'aria-hidden': 'true' }] } },
  ],
}).data;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <Fragment set:html={logo} />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.6rem;
    font-size: 1.375rem;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  span {
    overflow: hidden;
  }

  .site-title :global(svg) {
    flex-shrink: 0;
    width: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
  }
</style>
