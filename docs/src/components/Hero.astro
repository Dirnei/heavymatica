---
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const picture = image && 'file' in image ? image.file : undefined;
---

<div class="hero">
  <div class="copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
  {
    picture && (
      <Image
        src={picture}
        widths={[640, 960, 1280]}
        sizes="(min-width: 50rem) 40rem, 100vw"
        loading="eager"
        fetchpriority="high"
        alt={image?.alt ?? ''}
      />
    )
  }
</div>

<style>
  .hero {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-block: 2rem 1.5rem;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  h1 {
    font-size: clamp(var(--sl-text-4xl), calc(1rem + 5vw), var(--sl-text-6xl));
    line-height: 1.05;
    color: var(--sl-color-white);
  }

  .tagline {
    max-width: 34ch;
    font-size: clamp(var(--sl-text-lg), calc(0.5rem + 1.2vw), var(--sl-text-xl));
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  img {
    width: 100%;
    height: auto;
    background: var(--hm-well);
    border-radius: var(--hm-radius);
    border: 1px solid var(--hm-rim-strong);
    box-shadow: 0 2rem 4rem -2rem rgb(0 0 0 / 0.8);
  }

  @media (min-width: 50rem) {
    .hero {
      grid-template-columns: 4fr 6fr;
      gap: 3rem;
      padding-block: clamp(2.5rem, calc(1rem + 8vmin), 7rem);
    }
  }
</style>
