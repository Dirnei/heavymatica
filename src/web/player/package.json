{
  "name": "heavymatica-player-web",
  "private": true,
  "type": "module",
  "description": "The player website of the Heavymatica Cloud.",
  "scripts": {
    "generate": "openapi-typescript ../../api/heavymatica-cloud.v1.yaml -o src/api/schema.d.ts",
    "dev": "npm run generate && astro dev",
    "build": "npm run generate && astro build",
    "check": "npm run generate && astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/svelte": "9.0.1",
    "astro": "7.3.8",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
